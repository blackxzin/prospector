# Copie para .env e preencha. NUNCA commite o .env.

# --- WA-AKG (já rodando com sua sessão conectada) ---
WAAKG_URL=http://localhost:3000
WAAKG_SESSION=
WAAKG_API_KEY=
# Segredo HMAC do webhook (gere com: openssl rand -hex 32)
WEBHOOK_SECRET=

# --- Scraper (gosom/google-maps-scraper) ---
GMAPS_URL=http://localhost:8080
GMAPS_DEPTH=5
GMAPS_MAX_TIME_SEG=300

# --- Regras de envio ---
MAX_POR_DIA=8
MAX_POR_HORA=3
# teto por dia para leads fora do Brasil (conta dentro do MAX_POR_DIA; 0 = sem teto separado)
MAX_EXTERIOR_POR_DIA=5
# Janelas de horário comercial (fim exclusivo) e dias úteis (0 = segunda ... 6 = domingo)
JANELAS=09:00-11:30,14:00-17:30
DIAS_UTEIS=0,1,2,3,4
TZ_PROSPECTOR=America/Sao_Paulo
INTERVALO_MIN_SEG=240
INTERVALO_MAX_SEG=720
DIGITANDO_MIN_SEG=5
DIGITANDO_MAX_SEG=20
FOLLOWUP_DIAS_UTEIS=3

# --- Pix (para cobranças e proposta em PDF; o QR é gerado no seu PC) ---
PIX_CHAVE=
# Nome e cidade como aparecem no seu banco (sem acento é ok)
PIX_NOME=
PIX_CIDADE=

# --- Backup ---
BACKUP_DIR=~/prospector-backups
BACKUP_MANTER=30

# --- Painel / webhook ---
WEB_HOST=127.0.0.1
WEB_PORT=5050
# 1 = notify-send no desktop
NOTIFICAR=1
# 1 = antes da 1ª mensagem, busca o lead no DuckDuckGo (Instagram, site, cardápio online com robô)
CHECAR_PRESENCA=1
# 1 = manda o portfólio como 2ª mensagem, 25 a 70 s depois da primeira (só português do Brasil)
PORTFOLIO_APOS_PRIMEIRA=1

# --- Arquivos (relativos à raiz do projeto) ---
DATA_DIR=data
# DB_PATH=data/prospector.db
# TEMPLATES_PATH=templates.yaml
# LISTAS_PATH=listas.yaml

# E-mail (canal alternativo). Use senha de app do Gmail (Conta Google > Segurança > Senhas de app), nunca a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_NOME=Lucas
MAX_EMAIL_POR_DIA=15
